{
  "expo": {
    "name": "Life Documentary",
    "slug": "life-documentary",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "lifedocumentary",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.macdarenz.lifedocumentary",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.macdarenz.lifedocumentary"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-image",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Life Documentary uses the camera to record your ten-second answers and take photos.",
          "microphonePermission": "Life Documentary uses the microphone to record your voice when you answer.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Life Documentary uses the microphone to record your voice when you answer."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Life Documentary opens your photo library so you can pick a photo or clip to add.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Life Documentary uses your location only to find the name of a place you add to a moment.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-video",
      "expo-notifications",
      "expo-apple-authentication"
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:8787"
    }
  }
}
