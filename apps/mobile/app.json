{
  "expo": {
    "name": "Life Documentary",
    "slug": "life-documentary",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "lifedocumentary",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.macdarenz.lifedocumentary",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.macdarenz.lifedocumentary"
    },
    "plugins": ["expo-router", "expo-font", "expo-splash-screen", "expo-image"]
  }
}
