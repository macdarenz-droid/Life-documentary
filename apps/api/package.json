{
  "name": "@life/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p eval/tsconfig.json",
    "test": "vitest run",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "eval:planner": "vitest run --config eval.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "~0.128.0",
    "@better-auth/expo": "~1.7.6",
    "@life/contracts": "workspace:*",
    "@life/story": "workspace:*",
    "aws4fetch": "1.0.20",
    "better-auth": "~1.7.6",
    "drizzle-orm": "~0.45.3",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@better-auth/core": "~1.7.6",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "drizzle-kit": "~0.31.11",
    "vitest": "~4.1.11",
    "wrangler": "^4.141.0"
  }
}
