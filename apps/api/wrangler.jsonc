{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "life-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "BUILD": "dev", "BETTER_AUTH_URL": "http://localhost:8787", "R2_BUCKET": "life-media" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "life-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "life-media" }],
  "ai": { "binding": "AI" },
  // The weekly cron (P16, D42): every 15 minutes, UTC; every real offset ends in :00, :30 or :45.
  "triggers": { "crons": ["*/15 * * * *"] },
  "workflows": [
    { "name": "episode-pipeline", "binding": "EPISODE_PIPELINE", "class_name": "EpisodePipeline" },
    // The re-cut run (P17, D43): one instance per claimed edit.
    { "name": "recut-pipeline", "binding": "RECUT_PIPELINE", "class_name": "RecutPipeline" },
  ],
}
